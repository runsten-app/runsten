# Runsten against the simulator, without a car:
#
#   docker compose --env-file sim.env up -d --build
#   task connect-sim        # OAuth connection through runsten-api, curl as the browser
#
# Then open http://127.0.0.1:8082 (admin / runsten-dev-password).
#
# A separate Compose project (volume, network): simulated data never mixes with a real
# instance. Development values only: the simulator's runsten-dev application, and a
# token key made of 32 zero bytes. Never use them for a real instance.
#
# In a browser, the Volvo ID redirect leads to http://simulator:8080: add
# "127.0.0.1 simulator" to /etc/hosts, or use task connect-sim.

COMPOSE_PROJECT_NAME=runsten-sim
COMPOSE_PROFILES=sim
# Built from this tree (--build), never mistaken for a published release.
RUNSTEN_VERSION=dev

POSTGRES_PASSWORD=runsten
RUNSTEN_DB_PASSWORD=runsten
RUNSTEN_TOKEN_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

RUNSTEN_VOLVO_API_KEY=dev
RUNSTEN_VOLVO_CLIENT_ID=runsten-dev
RUNSTEN_VOLVO_CLIENT_SECRET=runsten-dev-secret
# On runsten-web, which relays the callback to runsten-api.
RUNSTEN_VOLVO_REDIRECT_URI=http://127.0.0.1:8082/auth/volvo/callback
RUNSTEN_VOLVO_BASE_URL=http://simulator:8080
RUNSTEN_VOLVO_AUTH_URL=http://simulator:8080

# Scenario from scenarios/, played at x60.
RUNSTEN_SIM_SCENARIO=commute
RUNSTEN_SIM_SPEED=60

# Collector intervals divided by 60, like simulated time.
RUNSTEN_POLL_TICK=1s
RUNSTEN_POLL_PARKED=10s
RUNSTEN_POLL_ACTIVE=1s
RUNSTEN_POLL_RARE=1m
RUNSTEN_POLL_DETAILS=24m

# Debug page on http://127.0.0.1:8090.
RUNSTEN_DEBUG_ADDR=0.0.0.0:8090
