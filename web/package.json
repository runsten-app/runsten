{
  "name": "runsten-web",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=26.10.0 <27"
  },
  "scripts": {
    "gen": "openapi-typescript ../api/openapi.yaml --output src/shared/api/schema.d.ts",
    "dev": "npm run gen && vite",
    "build": "npm run gen && vite build",
    "typecheck": "npm run gen && vue-tsc --build",
    "lint": "npm run gen && eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run gen && vitest run --coverage"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "5.3.0",
    "@mdi/js": "7.4.47",
    "@tanstack/vue-query": "5.104.1",
    "chart.js": "4.5.1",
    "leaflet": "1.9.4",
    "openapi-fetch": "0.17.0",
    "protomaps-leaflet": "5.1.0",
    "vue": "3.5.43",
    "vue-chartjs": "5.3.4",
    "vue-i18n": "11.4.13",
    "vue-router": "5.3.1",
    "vuetify": "4.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "4.5.1",
    "@playwright/test": "1.63.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.4",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.3",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "jsonc-eslint-parser": "3.3.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "5.0.3",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.12"
  },
  "allowScripts": {
    "fsevents": false,
    "vue-demi": false
  }
}
