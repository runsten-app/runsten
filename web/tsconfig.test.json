{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"],
      "@test/*": ["./test/*"],
      "@fixtures/*": ["../internal/api/testdata/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/**/*.json",
    "test/**/*.ts",
    "../internal/api/testdata/*.json"
  ]
}
